# Configuración de Entorno
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-crm-super-secret-key-change-in-production

# Seguridad JWT
JWT_SECRET_KEY=jwt-secret-key-change-in-production-crm-core-api

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5433/crm_dev

# Base de datos para la suite de tests (opcional).
# Si no se define, los tests usan SQLite en memoria.
# TEST_DATABASE_URL=postgresql://crm_user:crm_password@localhost:5433/crm_test

# CORS (Orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
