# Environment configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-crm-super-secret-key-change-in-production

# JWT security
JWT_SECRET_KEY=jwt-secret-key-change-in-production-crm-core-api

# Database (PostgreSQL)
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5433/crm_dev

# Test suite database (optional).
# If not set, tests use in-memory SQLite.
# TEST_DATABASE_URL=postgresql://crm_user:crm_password@localhost:5433/crm_test

# CORS (allowed origins separated by commas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
