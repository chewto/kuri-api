# Configuración de Entorno
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-crm-super-secret-key-change-in-production

# Seguridad JWT
JWT_SECRET_KEY=jwt-secret-key-change-in-production-crm-core-api

# Base de datos (Por defecto SQLite si no se especifica)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/crm_db
DATABASE_URL=sqlite:///crm_dev.db

# CORS (Orígenes permitidos separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
